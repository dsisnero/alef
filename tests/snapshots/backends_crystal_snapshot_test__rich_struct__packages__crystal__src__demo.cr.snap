require "json"

# Low-level binding to the generated C FFI layer (demo.h).
#
# Every non-scalar value crosses the C ABI as a NUL-terminated JSON string
# (`LibC::Char*`); scalars pass by value. Strings returned by the library are
# owned by Rust and must be released with `demo_free_string`.
#
# Link against the FFI shared library. The library must be installed to a
# standard path, or you can pass --link-flags at build time:
#   crystal build ... --link-flags="-L/path/to/lib -Wl,-rpath,/path/to/lib"
@[Link(ldflags: "-ldemo_ffi")]
lib LibDemo
  fun free_string = demo_free_string(ptr : LibC::Char*) : Void
  fun last_error_code = demo_last_error_code() : Int32
  fun last_error_context = demo_last_error_context() : LibC::Char*

  struct Config
    _data : Void*
  end
  struct Options
    _data : Void*
  end
  fun config_from_json = demo_config_from_json(json : LibC::Char*) : Config*
  fun config_to_json = demo_config_to_json(ptr : Config*) : LibC::Char*
  fun config_free = demo_config_free(ptr : Config*)
  fun options_from_json = demo_options_from_json(json : LibC::Char*) : Options*
  fun options_to_json = demo_options_to_json(ptr : Options*) : LibC::Char*
  fun options_free = demo_options_free(ptr : Options*)

  # Create a new widget.
  fun create_widget = demo_create_widget(label : LibC::Char*) : Void*
  # Apply configuration.
  fun configure = demo_configure(cfg : Config*, opts : Options*) : Void
  # Describe the config.
  fun describe = demo_describe(cfg : Config*) : Config*
  fun widget_render = demo_widget_render(handle : Void*, cfg : Config*, opts : Options*) : LibC::Char*
  fun widget_free = demo_widget_free(handle : Void*) : Void
end

# demo — Crystal bindings generated by alef.
#
# Ruby-style API over the Rust core: snake_case methods, PascalCase types,
# Rust-like generic containers (`Array(T)`, `Hash(K, V)`), and fiber/`Channel`
# based concurrency for async and streaming methods.
module Demo
  VERSION = "0.1.0"

  # Configuration parameters.
  class Config
    include JSON::Serializable
    getter value : Int32 = 0
    getter label : String = ""
    getter tag : String?
    def initialize
    end
  end

  # Execution options.
  class Options
    include JSON::Serializable
    getter verbose : Bool = false
    getter max_retries : UInt32 = 0
    def initialize
    end
  end

  # An opaque widget handle.
  class Widget
    # Wraps the FFI handle; do not construct directly.
    def initialize(@handle : Void*)
    end
    # Raw handle for passing back across the C ABI.
    def to_unsafe : Void*
      @handle
    end
    def finalize
      LibDemo.widget_free(@handle) unless @handle.null?
    end
    # Render the widget with given config and options.
    def render(cfg : Config, opts : Options) : String
    __handle_cfg = LibDemo.config_from_json(cfg.to_json)
    __handle_opts = LibDemo.options_from_json(opts.to_json)
    __result = begin
          __ptr = LibDemo.widget_render(@handle, __handle_cfg, __handle_opts)
          raise "LibDemo.widget_render returned a null pointer" if __ptr.null?
          __json = String.new(__ptr)
          LibDemo.free_string(__ptr)
          __json
    end
    LibDemo.config_free(__handle_cfg)
    LibDemo.options_free(__handle_opts)
    __result
    end
  end

  # Configuration errors.
  class ConfigError < Exception
  end

  # Rendering errors.
  class RenderError < Exception
  end

  # Create a new widget.
  def self.create_widget(label : String) : Widget
    __ptr = LibDemo.create_widget(label)
    raise "LibDemo.create_widget returned a null pointer" if __ptr.null?
    Widget.new(__ptr)
  end

  # Apply configuration.
  def self.configure(cfg : Config, opts : Options) : Nil
    __handle_cfg = LibDemo.config_from_json(cfg.to_json)
    __handle_opts = LibDemo.options_from_json(opts.to_json)
    LibDemo.configure(__handle_cfg, __handle_opts)
    __code = LibDemo.last_error_code
    if __code != 0
      __ctx_ptr = LibDemo.last_error_context
      raise String.new(__ctx_ptr) unless __ctx_ptr.null?
      raise "unknown error"
    end
    nil
    LibDemo.config_free(__handle_cfg)
    LibDemo.options_free(__handle_opts)
  end

  # Describe the config.
  def self.describe(cfg : Config) : Config
    __handle_cfg = LibDemo.config_from_json(cfg.to_json)
    __ptr = LibDemo.describe(__handle_cfg)
    if __ptr.null?
      __ctx_ptr = LibDemo.last_error_context
      raise String.new(__ctx_ptr) unless __ctx_ptr.null?
      raise "LibDemo.describe returned a null pointer"
    end
    __json_ptr = LibDemo.config_to_json(__ptr)
    LibDemo.config_free(__ptr)
    __json = String.new(__json_ptr)
    LibDemo.free_string(__json_ptr)
    LibDemo.config_free(__handle_cfg)
    Config.from_json(__json)
  end
end
