require "json"

# Low-level binding to the generated C FFI layer (demo.h).
#
# Every non-scalar value crosses the C ABI as a NUL-terminated JSON string
# (`LibC::Char*`); scalars pass by value. Strings returned by the library are
# owned by Rust and must be released with `demo_free_string`.
#
# Link against the FFI shared library. The library must be installed to a
# standard path, or you can pass --link-flags at build time:
#   crystal build ... --link-flags="-L/path/to/lib -Wl,-rpath,/path/to/lib"
@[Link(ldflags: "-ldemo_ffi")]
lib LibDemo
  fun free_string = demo_free_string(ptr : LibC::Char*) : Void
  fun last_error_code = demo_last_error_code() : Int32
  fun last_error_context = demo_last_error_context() : LibC::Char*

  struct Config
    _data : Void*
  end
  fun config_from_json = demo_config_from_json(json : LibC::Char*) : Config*
  fun config_to_json = demo_config_to_json(ptr : Config*) : LibC::Char*
  fun config_free = demo_config_free(ptr : Config*)

  # Process input and return a result.
  fun process = demo_process(input : LibC::Char*, count : UInt32) : LibC::Char*
  # Build a config from another config.
  fun build = demo_build(config : Config*) : Config*
  # Add two integers.
  fun add = demo_add(a : Int32, b : Int32) : Int32
end

# demo — Crystal bindings generated by alef.
#
# Ruby-style API over the Rust core: snake_case methods, PascalCase types,
# Rust-like generic containers (`Array(T)`, `Hash(K, V)`), and fiber/`Channel`
# based concurrency for async and streaming methods.
module Demo
  VERSION = "0.1.0"

  # Processing status.
  enum Status
    Active
    Inactive
  end

  # A demo configuration struct.
  class Config
    include JSON::Serializable
    getter value : Int32 = 0
    getter label : String = ""
    getter tag : String?
    def initialize
    end
  end

  # Errors emitted by demo operations.
  class DemoError < Exception
  end

  # Process input and return a result.
  def self.process(input : String, count : UInt32) : String
    __ptr = LibDemo.process(input, count)
    raise "LibDemo.process returned a null pointer" if __ptr.null?
    __json = String.new(__ptr)
    LibDemo.free_string(__ptr)
    __json
  end

  # Build a config from another config.
  def self.build(config : Config) : Config
    __handle_config = LibDemo.config_from_json(config.to_json)
    __ptr = LibDemo.build(__handle_config)
    if __ptr.null?
      __ctx_ptr = LibDemo.last_error_context
      raise String.new(__ctx_ptr) unless __ctx_ptr.null?
      raise "LibDemo.build returned a null pointer"
    end
    __json_ptr = LibDemo.config_to_json(__ptr)
    LibDemo.config_free(__ptr)
    __json = String.new(__json_ptr)
    LibDemo.free_string(__json_ptr)
    LibDemo.config_free(__handle_config)
    Config.from_json(__json)
  end

  # Add two integers.
  def self.add(a : Int32, b : Int32) : Int32
    LibDemo.add(a, b)
  end
end
