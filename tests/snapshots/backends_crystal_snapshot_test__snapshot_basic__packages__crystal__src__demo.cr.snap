require "json"

# Low-level binding to the generated C FFI layer (demo.h).
#
# Every non-scalar value crosses the C ABI as a NUL-terminated JSON string
# (`LibC::Char*`); scalars pass by value. Strings returned by the library are
# owned by Rust and must be released with `demo_free_string`.
@[Link(ldflags: "-ldemo_ffi")]
lib LibDemo
  fun free_string = demo_free_string(ptr : LibC::Char*) : Void
  # Process input and return a result.
  fun process = demo_process(input : LibC::Char*, count : UInt32) : LibC::Char*
  # Build a config from another config.
  fun build = demo_build(config : LibC::Char*) : LibC::Char*
  # Add two integers.
  fun add = demo_add(a : Int32, b : Int32) : Int32
end

# demo — Crystal bindings generated by alef.
#
# Ruby-style API over the Rust core: snake_case methods, PascalCase types,
# Rust-like generic containers (`Array(T)`, `Hash(K, V)`), and fiber/`Channel`
# based concurrency for async and streaming methods.
module Demo
  VERSION = "0.1.0"

  # A demo configuration struct.
  class Config
    include JSON::Serializable
    getter value : Int32
    getter label : String
    getter tag : String?
  end

  # Processing status.
  enum Status
    Active
    Inactive
  end

  # Errors emitted by demo operations.
  class DemoError < Exception
  end

  # Process input and return a result.
  def self.process(input : String, count : UInt32) : String
    __ptr = LibDemo.process(input.to_json, count)
    raise "LibDemo.process returned a null pointer" if __ptr.null?
    __json = String.new(__ptr)
    LibDemo.free_string(__ptr)
    __json
  end

  # Build a config from another config.
  def self.build(config : Config) : Config
    __ptr = LibDemo.build(config.to_json)
    raise "LibDemo.build returned a null pointer" if __ptr.null?
    __json = String.new(__ptr)
    LibDemo.free_string(__ptr)
    Config.from_json(__json)
  end

  # Add two integers.
  def self.add(a : Int32, b : Int32) : Int32
    LibDemo.add(a, b)
  end
end
